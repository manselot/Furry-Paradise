{
	"nodes":[
		{"id":"group2","type":"group","x":-420,"y":910,"width":820,"height":1820,"color":"5","label":"Административный корпус"},
		{"id":"group3","type":"group","x":-420,"y":2730,"width":820,"height":1430,"color":"6","label":"Общежитие №3, комната 314"},
		{"id":"group1","type":"group","x":-420,"y":-240,"width":860,"height":1150,"color":"4","label":"Площадь перед Академией"},
		{"id":"B","type":"text","text":"**Внутренний монолог**\nЗверолюди почти неотличимы от людей. ГГ скрывает, что он Первородный — заметно только по документам.","x":-140,"y":40,"width":380,"height":120},
		{"id":"Cshow","type":"text","text":"🟩 CharacterControl\nАлина: show","x":-140,"y":260,"width":280,"height":70,"color":"5"},
		{"id":"D","type":"text","text":"**Встреча с Алиной**\nОкликает ГГ, крепко обнимает — «Ты поступил!»","x":-140,"y":335,"width":340,"height":105},
		{"id":"E","type":"text","text":"❓ Выбор игрока\nАлина: «Уже знаешь, где будешь жить?»","x":-140,"y":520,"width":280,"height":80,"color":"3"},
		{"id":"E1","type":"text","text":"▸ «Нет. Только приехал.»","x":-380,"y":650,"width":240,"height":70,"color":"2"},
		{"id":"E2","type":"text","text":"▸ «Только что сошёл с автобуса.»","x":120,"y":650,"width":240,"height":70,"color":"2"},
		{"id":"F","type":"text","text":"**Идут в администрацию**\nШутка про то, что Алина не даёт донести чемодан.","x":-140,"y":780,"width":280,"height":90},
		{"id":"Vshow","type":"text","text":"🟩 CharacterControl\nВиктория: show","x":-140,"y":910,"width":280,"height":70,"color":"5"},
		{"id":"G","type":"text","text":"Видят Викторию у терминала — изучает расписание, поначалу не замечает, что ГГ человек.","x":-140,"y":1040,"width":280,"height":90},
		{"id":"Clshow","type":"text","text":"🟩 CharacterControl\nСотрудница: show","x":-140,"y":1170,"width":280,"height":70,"color":"5"},
		{"id":"H","type":"text","text":"Сотрудница проверяет документы ГГ.","x":-140,"y":1300,"width":280,"height":80},
		{"id":"I","type":"text","text":"Виктория случайно видит документ — лицо меняется, подходит ближе.","x":-140,"y":1430,"width":280,"height":90},
		{"id":"J","type":"text","text":"❓ Выбор игрока\nВиктория: «Ты человек?»","x":-140,"y":1560,"width":280,"height":80,"color":"3"},
		{"id":"J1","type":"text","text":"▸ «Похоже, документы меня выдали.»","x":-380,"y":1690,"width":240,"height":70,"color":"2"},
		{"id":"J2","type":"text","text":"▸ «А ты как думаешь?»","x":120,"y":1690,"width":240,"height":70,"color":"2"},
		{"id":"K1a","type":"text","text":"Виктория: «Хм. Значит, всё-таки да.»","x":120,"y":1820,"width":240,"height":70},
		{"id":"K1","type":"text","text":"Виктория: «Интересно.» Знакомство начинается.","x":-140,"y":1950,"width":280,"height":80},
		{"id":"L","type":"text","text":"**Знакомство**\nИмена, рукопожатие: Виктория Морозова (2 курс) — Алексей Орлов (1 курс).","x":-140,"y":2080,"width":280,"height":90},
		{"id":"M","type":"text","text":"Сотрудница выдаёт направление: общежитие №3, комната 314.","x":-140,"y":2210,"width":280,"height":90},
		{"id":"Clhide","type":"text","text":"🟥 CharacterControl\nСотрудница: hide","x":-140,"y":2340,"width":280,"height":70,"color":"1"},
		{"id":"N","type":"text","text":"Алина: «Поздравляю. Теперь ты официально студент Академии Новой Эволюции.»","x":-140,"y":2470,"width":280,"height":90},
		{"id":"Vhide","type":"text","text":"🟥 CharacterControl\nВиктория: hide","x":-140,"y":2600,"width":280,"height":70,"color":"1"},
		{"id":"O","type":"text","text":"Идут к общежитию. Шутка про душевые.","x":-140,"y":2730,"width":280,"height":90},
		{"id":"P","type":"text","text":"Заселение в комнату 314 — две кровати, два стола, шкаф, окно. Сосед ещё не приехал.","x":-140,"y":2860,"width":280,"height":90},
		{"id":"Q","type":"text","text":"❓ Выбор игрока (косметический)\nЧто разложить сначала?","x":-140,"y":2990,"width":280,"height":80,"color":"3"},
		{"id":"Q1","type":"text","text":"▸ Разложить одежду в шкаф","x":-380,"y":3120,"width":240,"height":70,"color":"2"},
		{"id":"Q2","type":"text","text":"▸ Сначала достать ноутбук","x":120,"y":3120,"width":240,"height":70,"color":"2"},
		{"id":"R","type":"text","text":"Комната обжита — книги на полке и т.д.","x":-140,"y":3250,"width":280,"height":80},
		{"id":"S","type":"text","text":"Алина смотрит на часы — «Чёрт».","x":-140,"y":3380,"width":280,"height":70},
		{"id":"T","type":"text","text":"Алина уходит к куратору клуба — шутка про то, что ГГ «потерялся три раза на выпускном».","x":-140,"y":3510,"width":280,"height":90},
		{"id":"Ahide","type":"text","text":"🟥 CharacterControl\nАлина: hide","x":-140,"y":3640,"width":280,"height":70,"color":"1"},
		{"id":"U","type":"text","text":"ГГ один в комнате — осознаёт: новый город, новый университет, новая жизнь.","x":-140,"y":3770,"width":280,"height":90},
		{"id":"W","type":"text","text":"Желудок напоминает о себе → решение идти искать еду.","x":-140,"y":3900,"width":280,"height":80},
		{"id":"X","type":"text","text":"➡️ jump: scene_03\nСпускается на кухню — сцена обрывается на открытой двери.","x":-140,"y":4030,"width":280,"height":90,"color":"4"},
		{"id":"A","type":"text","text":"**Приезд**\nАвтобус останавливается у ворот Академии Новой Эволюции. ГГ выходит на площадь.","x":-140,"y":-160,"width":380,"height":130}
